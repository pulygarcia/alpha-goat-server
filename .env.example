# App
PORT=3001
NODE_ENV=development
# Acepta varios origenes separados por coma (prod + previews del front).
FRONTEND_URL=http://localhost:3000

# Database (Neon / Postgres)
# DATABASE_PASSWORD solo sirve para interpolar la URL de abajo en local; en el
# server se setea DATABASE_URL completa y esta variable no hace falta.
DATABASE_PASSWORD=replace-me
DATABASE_URL=postgresql://neondb_owner:${DATABASE_PASSWORD}@host.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=replace-me-with-openssl-rand-base64-32
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin seed (solo necesarias para `npm run seed:admin`)
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
